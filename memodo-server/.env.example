# ============================================================
#  Memodo sync server configuration
#  复制为 .env 后务必修改以下两项再对外提供服务！
#  Copy to .env and CHANGE these before exposing to any network.
# ============================================================

# JWT 签名密钥 —— 生成: openssl rand -hex 32
# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# PostgreSQL 密码 —— 生成: openssl rand -hex 16
# PostgreSQL password — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE-ME

# 数据库连接串（compose 内服务名固定为 db）
# Database URL (service name is fixed to "db" in docker-compose)
DATABASE_URL=postgresql+asyncpg://memodo:${POSTGRES_PASSWORD}@db:5432/memodo
