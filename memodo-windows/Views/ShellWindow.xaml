<Window x:Class="Memodo.Windows.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="念念 Memodo"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                <RadioButton x:Name="NavTodo"     Style="{StaticResource NavButton}" Tag="todo"     Margin="0,0,0,8"  Click="Nav_Clicked" IsChecked="True" />
                <RadioButton x:Name="NavMemo"     Style="{StaticResource NavButton}" Tag="memo"     Margin="0,0,0,8"  Click="Nav_Clicked" />
                <RadioButton x:Name="NavBoard"    Style="{StaticResource NavButton}" Tag="board"    Margin="0,0,0,8"  Click="Nav_Clicked" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Margin="0,0,0,8"  Click="Nav_Clicked" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" />
    </Grid>
</Window>
