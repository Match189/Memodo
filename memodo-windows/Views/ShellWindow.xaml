<Window x:Class="Memodo.Windows.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_app_title}"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 自绘标题栏：拖动区 + 显示方式切换 + 窗口控制 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource S_app_title}" Margin="14,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource SecondaryLabel}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="&#xE921;" Style="{StaticResource CapBtn}" Click="Min_Click"  ToolTip="{DynamicResource S_tip_min}"/>
                    <Button Content="&#xE922;" Style="{StaticResource CapBtn}" Click="Max_Click"  ToolTip="{DynamicResource S_tip_max}"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CapCloseBtn}" Click="CloseBtn_Click" ToolTip="{DynamicResource S_tip_close}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侧栏：待办 / 备忘 / 设置（钉板经标题栏切换进入，不再单独占 tab） -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                <RadioButton x:Name="NavTodo"     Style="{StaticResource NavButton}" Tag="todo"     Content="&#xE73A;" Margin="0,0,0,8"  Click="Nav_Clicked" IsChecked="True" ToolTip="{DynamicResource S_tip_nav_todo}"/>
                <RadioButton x:Name="NavMemo"     Style="{StaticResource NavButton}" Tag="memo"     Content="&#xE70F;" Margin="0,0,0,8"  Click="Nav_Clicked" ToolTip="{DynamicResource S_tip_nav_memo}"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Content="&#xE713;" Margin="0,0,0,8"  Click="Nav_Clicked" ToolTip="{DynamicResource S_tip_nav_settings}"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1" Grid.Column="1" />
    </Grid>
</Window>
