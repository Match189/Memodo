<UserControl x:Class="Memodo.Windows.Views.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- LargeTitle + 计数 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource S_PageTodo}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Label}" />
                <TextBlock x:Name="CountText" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryLabel}" />
            </StackPanel>
        </DockPanel>

        <!-- 填充式输入行（Fill 底、圆角 8、聚焦 tint 环） -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="InputBorder" Grid.Column="0" Background="{DynamicResource Fill}"
                    CornerRadius="8" BorderThickness="2" BorderBrush="Transparent">
                <TextBox x:Name="NewTitle" Padding="12,8" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Label}" VerticalContentAlignment="Center"
                         GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                         KeyDown="NewTitle_KeyDown" />
            </Border>
            <Button Grid.Column="1" Content="{DynamicResource S_Add}" Margin="8,0,0,0" Padding="18,0"
                    Height="34" Style="{StaticResource AccentBtn}" Click="Add_Click" />
        </Grid>

        <!-- Inset Grouped：单容器 + 发丝线分行（§3） -->
        <Grid Grid.Row="2">
            <ListBox x:Name="List" Background="{DynamicResource Surface}" BorderThickness="1"
                     BorderBrush="{DynamicResource Separator}"
                     ItemsSource="{Binding Tasks}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,10,0,2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryLabel}" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                            <Grid Height="46" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource AppleCheck}"
                                          IsChecked="{Binding Completed}" VerticalAlignment="Center"
                                          Click="Toggle_Click" Tag="{Binding Id}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextDecorations="{Binding Completed, Converter={StaticResource StrikeThrough}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Label}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabel}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="编辑" Margin="0,0,6,0"
                                            Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                                            Click="Edit_Click" Tag="{Binding Id}" />
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="删除"
                                            Foreground="{DynamicResource Danger}" Background="Transparent" BorderThickness="0"
                                            Click="Remove_Click" Tag="{Binding Id}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           Foreground="{DynamicResource TertiaryLabel}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource S_EmptyTasks}" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryLabel}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
