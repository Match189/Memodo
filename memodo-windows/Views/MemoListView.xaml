<UserControl x:Class="Memodo.Windows.Views.MemoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource S_page_memo}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource Label}" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="{DynamicResource S_show_all}" Style="{StaticResource PlainBtn}"
                    Click="ShowAll_Click" ToolTip="{DynamicResource S_show_all}"/>
        </DockPanel>

        <!-- 备忘编辑卡：标题 / 分隔线 / 多行内容 / 添加（与钉板快速添加同一层级语感） -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10"
                BorderThickness="1" BorderBrush="{DynamicResource Separator}" Margin="0,0,0,12"
                Padding="14,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 标题行：单行、加粗、大一号 -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="NewTitle" Padding="2,3" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Label}" FontSize="14" FontWeight="SemiBold"
                             KeyDown="NewTitle_KeyDown" />
                    <TextBlock x:Name="TitlePlaceholder" Text="{DynamicResource S_memo_title_placeholder}"
                               Foreground="{DynamicResource TertiaryLabel}" FontSize="14" FontWeight="SemiBold"
                               Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Separator Grid.Row="1" Margin="0,7" Background="{DynamicResource Separator}"/>
                <!-- 内容行：多行文本域，高度明显区别于标题 -->
                <Grid Grid.Row="2" MinHeight="64">
                    <TextBox x:Name="NewContent" Padding="2,3" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Label}" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="NewContent_KeyDown" />
                    <TextBlock x:Name="ContentPlaceholder" Text="{DynamicResource S_memo_content_placeholder}"
                               Foreground="{DynamicResource TertiaryLabel}" FontSize="13"
                               Margin="3,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Row="3" Content="{DynamicResource S_add}" HorizontalAlignment="Right"
                        MinWidth="88" Height="32" Margin="0,8,0,0"
                        Style="{StaticResource AccentBtn}" Click="Add_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="List" Background="{DynamicResource Surface}" BorderThickness="1"
                     BorderBrush="{DynamicResource Separator}"
                     ItemsSource="{Binding Memos}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,10,0,2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryLabel}" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                            <Grid MinHeight="52" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 眼睛按钮：控制是否显示在钉板（备忘无完成语义，用户裁定） -->
                                <Border Grid.Column="0" Width="28" Height="28"
                                        VerticalAlignment="Center" CornerRadius="4"
                                        Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonDown="Eye_Click" Tag="{Binding Id}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowOnBoard}" Value="True">
                                                    <Setter Property="ToolTip" Value="{DynamicResource S_memo_hide_tip}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowOnBoard}" Value="False">
                                                    <Setter Property="Background" Value="#22FF0000" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource S_memo_show_tip}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE7B3;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOnBoard}" Value="False">
                                                        <Setter Property="Text" Value="&#xE8F4;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,0,10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOnBoard}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryLabel}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryLabel}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="11" Foreground="{DynamicResource TertiaryLabel}"
                                           Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="{DynamicResource S_tip_edit}" Margin="0,0,6,0"
                                            Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                                            Click="Edit_Click" Tag="{Binding Id}" />
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="{DynamicResource S_tip_delete}"
                                            Foreground="{DynamicResource Danger}" Background="Transparent" BorderThickness="0"
                                            Click="Remove_Click" Tag="{Binding Id}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           Foreground="{DynamicResource TertiaryLabel}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource S_empty_memos}" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryLabel}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
