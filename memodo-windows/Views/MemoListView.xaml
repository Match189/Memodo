<UserControl x:Class="Memodo.Windows.Views.MemoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S_PageMemo}" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource Label}" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="{DynamicResource Fill}" CornerRadius="8"
                BorderThickness="2" BorderBrush="Transparent" Margin="0,0,0,16">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTitle" Grid.Column="0" Padding="10,6" BorderThickness="0"
                         Background="Transparent" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Label}"
                         KeyDown="NewTitle_KeyDown" />
                <TextBox x:Name="NewContent" Grid.Column="1" Padding="10,6" Margin="8,0" BorderThickness="0"
                         Background="Transparent" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Label}"
                         KeyDown="NewContent_KeyDown" />
                <Button Grid.Column="2" Content="{DynamicResource S_Add}" Padding="18,0" Height="34"
                        Style="{StaticResource AccentBtn}" Click="Add_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="List" Background="{DynamicResource Surface}" BorderThickness="1"
                     BorderBrush="{DynamicResource Separator}"
                     ItemsSource="{Binding Memos}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,10,0,2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryLabel}" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                            <Grid MinHeight="52" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 眼睛按钮：控制是否显示在钉板（备忘无完成语义，用户裁定） -->
                                <Button Grid.Column="0" Width="28" Height="28"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                        Click="Eye_Click" Tag="{Binding Id}" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            <Setter Property="Content" Value="&#xE7B3;" />
                                            <Setter Property="ToolTip" Value="点击不在钉板显示" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowOnBoard}" Value="False">
                                                    <Setter Property="Content" Value="&#xED1A;" />
                                                    <Setter Property="ToolTip" Value="点击在钉板显示" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabel}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="12,10,0,10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOnBoard}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryLabel}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="编辑" Margin="0,0,6,0"
                                            Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                                            Click="Edit_Click" Tag="{Binding Id}" />
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                            ToolTip="删除"
                                            Foreground="{DynamicResource Danger}" Background="Transparent" BorderThickness="0"
                                            Click="Remove_Click" Tag="{Binding Id}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           Foreground="{DynamicResource TertiaryLabel}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource S_EmptyMemos}" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryLabel}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
