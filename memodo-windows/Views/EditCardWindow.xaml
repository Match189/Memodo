<Window x:Class="Memodo.Windows.Views.EditCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_edit_card}" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceElevated}">
    <StackPanel Margin="16">
        <TextBlock x:Name="KindText" Text="{DynamicResource S_edit_card}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
        <TextBlock Text="{DynamicResource S_card_title}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Padding="8,6" Margin="0,0,0,10"/>
        <TextBlock x:Name="ContentLabel" Text="{DynamicResource S_card_content}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox x:Name="ContentBox" Padding="8,6" Margin="0,0,0,12" MinHeight="72"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- 图钉色（4 色分类）+ 便签纸色（设计文档 5 色） -->
        <StackPanel x:Name="ColorPanel" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource S_pin_color}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border x:Name="PinRed"    Width="22" Height="22" CornerRadius="11" Background="#E85A4F" Tag="red"    Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Pin_Click"/>
                <Border x:Name="PinBlue"   Width="22" Height="22" CornerRadius="11" Background="#4A90E2" Tag="blue"   Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Pin_Click"/>
                <Border x:Name="PinGreen"  Width="22" Height="22" CornerRadius="11" Background="#5CB85C" Tag="green"  Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Pin_Click"/>
                <Border x:Name="PinYellow" Width="22" Height="22" CornerRadius="11" Background="#F0AD4E" Tag="yellow" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Pin_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource S_note_color_short}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border x:Name="NoteYellow" Width="22" Height="22" Background="#FFF9C4" Tag="yellow" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Note_Click"/>
                <Border x:Name="NotePink"   Width="22" Height="22" Background="#FCE4EC" Tag="pink"   Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Note_Click"/>
                <Border x:Name="NoteBlue"   Width="22" Height="22" Background="#E3F2FD" Tag="blue"   Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Note_Click"/>
                <Border x:Name="NoteGreen"  Width="22" Height="22" Background="#E8F5E9" Tag="green"  Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Note_Click"/>
                <Border x:Name="NoteOrange" Width="22" Height="22" Background="#FFF3E0" Tag="orange" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="Note_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource S_cancel}" Padding="14,6" Style="{StaticResource PlainBtn}" Click="Cancel_Click"/>
            <Button Content="{DynamicResource S_save}" Padding="14,6" Margin="8,0,0,0"
                    Style="{DynamicResource AccentBtn}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
