<Window x:Class="Memodo.Windows.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="念念 · 桌面组件"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False" ResizeMode="CanResize"
        Width="380" Height="520" MinWidth="300" MinHeight="360">
    <Border CornerRadius="16" Background="#F7FCFF" BorderBrush="#BFE0E8" BorderThickness="1"
            Margin="10" Padding="0" Effect="{DynamicResource DropShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（拖动区） -->
            <Border Grid.Row="0" Background="#0080A0" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <TextBlock Text="念念 · 桌面" Foreground="White" FontWeight="Bold"
                               FontSize="14" Margin="14,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="主窗口" Style="{StaticResource WidgetBtn}" Click="OpenMain_Click"/>
                        <Button Content="×" Style="{StaticResource WidgetBtn}" FontSize="16" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 双栏：待办 | 备忘 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="今日待办" FontWeight="SemiBold"
                               Foreground="#0080A0" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodoPanel"/>
                    </ScrollViewer>
                </DockPanel>

                <Rectangle Grid.Column="1" Fill="#DDE7EA"/>

                <DockPanel Grid.Column="2" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="备忘" FontWeight="SemiBold"
                               Foreground="#0080A0" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MemoPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- 添加栏 -->
            <Border Grid.Row="2" Background="#EAF6FA" CornerRadius="0,0,16,16">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="ModeTodo" Content="待办" Style="{StaticResource SegBtn}" Click="ModeTodo_Click"/>
                        <Button x:Name="ModeMemo" Content="备忘" Style="{StaticResource SegBtn}" Click="ModeMemo_Click"/>
                    </StackPanel>

                    <TextBox x:Name="AddBox" Grid.Column="1" VerticalAlignment="Center"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="AddBox_KeyDown" Text="添加…" Foreground="#999"
                             GotFocus="AddBox_GotFocus" LostFocus="AddBox_LostFocus"/>

                    <Button x:Name="AddBtn" Grid.Column="2" Content="添加" Margin="8,0,0,0"
                            Style="{StaticResource AccentBtn}" Click="Add_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
