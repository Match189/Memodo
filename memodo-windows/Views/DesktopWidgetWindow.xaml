<Window x:Class="Memodo.Windows.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource S_widget_title_label}"
        WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Width="380" Height="520" MinWidth="280" MinHeight="320">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- 材质由 WindowChrome.SetSurface（毛玻璃/透明+不透明度）提供；
         RootSheet 自身透明度与滑杆联动，保证滑杆在任何系统上都可见 -->
    <Border x:Name="RootSheet" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 背景层跨越标题栏：软木纹理/背景图延伸满整个组件 -->
            <ContentControl x:Name="CorkHost" Grid.RowSpan="2"/>

            <!-- 钉板视图（§19 迷你 Board，软木板纹理） -->
            <Grid x:Name="BoardMode" Grid.RowSpan="2" Margin="0,42,0,0">
                <Canvas x:Name="Board" ClipToBounds="True" Background="Transparent" Margin="10,8"
                        MouseLeftButtonDown="BoardArea_MouseDown"/>
                <TextBlock x:Name="BoardEmpty" Text="{DynamicResource S_widget_empty_board_hint}"
                           TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- 标题栏浮层：半透明压暗，露出下方画布纹理；按钮保持窗口功能 -->
            <Border Grid.Row="0" Background="#661C1C1E">
                <Grid>
                    <TextBlock Text="{DynamicResource S_widget_title}" Foreground="White" FontWeight="SemiBold"
                               FontSize="13" Margin="14,0" VerticalAlignment="Center"
                               Effect="{DynamicResource TitleShadow}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TopBtn" Content="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource WidgetBtn}" Click="Top_Click" ToolTip="{DynamicResource S_widget_topmost_tooltip}"/>
                        <Button x:Name="LockBtn" Content="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource WidgetBtn}" Click="LockBtn_Click" ToolTip="{DynamicResource S_widget_lock_tooltip}"/>
                        <Button x:Name="MenuBtn" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource WidgetBtn}" Click="Menu_Click" ToolTip="{DynamicResource S_widget_menu_tooltip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 列表视图（传统：待办 | 备忘 双栏）；底色用 WidgetSheet 保证可读 -->
            <Grid x:Name="ListMode" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WidgetSheet}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S_widget_todo_col}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodoPanel" Background="Transparent"
                                    MouseLeftButtonDown="BoardArea_MouseDown"/>
                    </ScrollViewer>
                </DockPanel>
                <Rectangle Grid.Column="1" Fill="{DynamicResource Separator}"/>
                <DockPanel Grid.Column="2" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S_widget_memo_col}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MemoPanel" Background="Transparent"
                                    MouseLeftButtonDown="BoardArea_MouseDown"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
