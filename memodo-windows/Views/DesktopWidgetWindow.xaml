<Window x:Class="Memodo.Windows.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="念念 · 桌面组件"
        WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Width="380" Height="520" MinWidth="280" MinHeight="320">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- 材质由 WindowChrome.SetSurface（毛玻璃/透明+不透明度）提供，背景保持透明让 blur 透出 -->
    <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：左标题，右侧 置顶开关 + 选项菜单 -->
            <Border Grid.Row="0" Background="{DynamicResource Accent}">
                <Grid>
                    <TextBlock Text="📌 念念" Foreground="White" FontWeight="SemiBold"
                               FontSize="13" Margin="14,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TopBtn" Content="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource WidgetBtn}" Click="Top_Click" ToolTip="始终置顶 开/关"/>
                        <Button x:Name="MenuBtn" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource WidgetBtn}" Click="Menu_Click" ToolTip="选项"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 钉板视图（§19 迷你 Board，软木板纹理） -->
            <Grid x:Name="BoardMode" Grid.Row="1">
                <ContentControl x:Name="CorkHost"/>
                <Canvas x:Name="Board" ClipToBounds="True" Background="Transparent" Margin="10,8"
                        MouseLeftButtonDown="BoardArea_MouseDown"/>
                <TextBlock x:Name="BoardEmpty" Text="还没有钉住的卡片&#x0a;双击此处快速添加"
                           TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- 列表视图（传统：待办 | 备忘 双栏） -->
            <Grid x:Name="ListMode" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="今日待办" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodoPanel" Background="Transparent"
                                    MouseLeftButtonDown="BoardArea_MouseDown"/>
                    </ScrollViewer>
                </DockPanel>
                <Rectangle Grid.Column="1" Fill="{DynamicResource CardBorder}"/>
                <DockPanel Grid.Column="2" Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="备忘" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MemoPanel" Background="Transparent"
                                    MouseLeftButtonDown="BoardArea_MouseDown"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
