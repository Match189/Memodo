<Application x:Class="Memodo.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Memodo.Windows.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 设计令牌默认值（启动时由 ThemeService.Apply 覆盖，XAML 一律 DynamicResource） -->
            <SolidColorBrush x:Key="AppBackground" Color="#FFF5F7F8" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#FFEAF1F3" />
            <SolidColorBrush x:Key="SubtleText" Color="#FF66727A" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FF33302B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FF8A8070" />
            <SolidColorBrush x:Key="Accent" Color="#FF0080A0" />
            <SolidColorBrush x:Key="Danger" Color="#FFB00020" />
            <SolidColorBrush x:Key="BoardBackground" Color="#FFE8D5BC" />
            <SolidColorBrush x:Key="BoardBackgroundAlt" Color="#FFDCC5A6" />
            <SolidColorBrush x:Key="CardSurface" Color="#FFFDF8EC" />
            <SolidColorBrush x:Key="CardBorder" Color="#FFE2D6C2" />
            <SolidColorBrush x:Key="GlassPanel" Color="#FFF2FBFD" />
            <SolidColorBrush x:Key="GlassBorder" Color="#FFBFE0E8" />

            <DropShadowEffect x:Key="DropShadow" BlurRadius="18" ShadowDepth="0"
                              Color="#40000000" Opacity="0.22" />
            <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2"
                              Color="#33000000" Opacity="0.35" />

            <!-- 侧栏导航按钮（Segoe MDL2 图标） -->
            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Margin" Value="8,2,8,2" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Back" Background="Transparent" CornerRadius="10" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#22000000" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 自绘标题栏按钮 -->
            <Style x:Key="CapBtn" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#22000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 桌面组件标题栏按钮 -->
            <Style x:Key="WidgetBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 桌面组件段落切换按钮 -->
            <Style x:Key="SegBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- 主按钮 -->
            <Style x:Key="AccentBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF0099BF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片删除按钮 -->
            <Style x:Key="CardDelBtn" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <conv:StrikeThroughConverter x:Key="StrikeThrough" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
